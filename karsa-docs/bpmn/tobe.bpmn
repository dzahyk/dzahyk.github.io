<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_tobe" targetNamespace="https://github.com/dzahyk/karsa">
 <bpmn:collaboration id="Collab_tobe">
  <bpmn:participant id="Participant_tobe" name="TO-BE: Karsa deal desk" processRef="Process_tobe" />
 </bpmn:collaboration>
 <bpmn:process id="Process_tobe" isExecutable="false">
  <bpmn:laneSet id="LaneSet_tobe">
   <bpmn:lane id="Lane_A" name="Analyst"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>A1</bpmn:flowNodeRef><bpmn:flowNodeRef>A2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>A3</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_S" name="Karsa (system)"><bpmn:flowNodeRef>Y1</bpmn:flowNodeRef><bpmn:flowNodeRef>Y2</bpmn:flowNodeRef><bpmn:flowNodeRef>Y3</bpmn:flowNodeRef><bpmn:flowNodeRef>Y4</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_P" name="Approver"><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>P1</bpmn:flowNodeRef><bpmn:flowNodeRef>P2</bpmn:flowNodeRef><bpmn:flowNodeRef>P3</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_X" name="Automation Eng."><bpmn:flowNodeRef>X1</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="S" name="Brief received"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
  <bpmn:task id="A1" name="Create case (paste / upload)"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task>
  <bpmn:task id="Y1" name="Extract drafts with evidence"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
  <bpmn:task id="A2" name="Review and confirm requirements"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
  <bpmn:exclusiveGateway id="G1" name="All critical confirmed?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:task id="A3" name="Clarify with client (channel + ref)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
  <bpmn:task id="Y2" name="Price deterministically"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
  <bpmn:task id="Y3" name="Freeze package (SHA-256)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
  <bpmn:exclusiveGateway id="G2" name="High risk?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:task id="P1" name="Approve (single)"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
  <bpmn:task id="P2" name="Exception + two approvers"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
  <bpmn:task id="P3" name="Authorize execution"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
  <bpmn:task id="Y4" name="Write CRM + tracker (idempotent)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
  <bpmn:exclusiveGateway id="G3" name="Read-back = hash?"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:endEvent id="E1" name="Completed (verified)"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
  <bpmn:task id="X1" name="Reconcile / exception queue"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:task>
  <bpmn:sequenceFlow id="Flow_0" sourceRef="S" targetRef="A1" />
  <bpmn:sequenceFlow id="Flow_1" sourceRef="A1" targetRef="Y1" />
  <bpmn:sequenceFlow id="Flow_2" sourceRef="Y1" targetRef="A2" />
  <bpmn:sequenceFlow id="Flow_3" sourceRef="A2" targetRef="G1" />
  <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="G1" targetRef="A3" />
  <bpmn:sequenceFlow id="Flow_5" sourceRef="A3" targetRef="A2" />
  <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="G1" targetRef="Y2" />
  <bpmn:sequenceFlow id="Flow_7" sourceRef="Y2" targetRef="Y3" />
  <bpmn:sequenceFlow id="Flow_8" sourceRef="Y3" targetRef="G2" />
  <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="G2" targetRef="P1" />
  <bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="G2" targetRef="P2" />
  <bpmn:sequenceFlow id="Flow_11" sourceRef="P1" targetRef="P3" />
  <bpmn:sequenceFlow id="Flow_12" sourceRef="P2" targetRef="P3" />
  <bpmn:sequenceFlow id="Flow_13" sourceRef="P3" targetRef="Y4" />
  <bpmn:sequenceFlow id="Flow_14" sourceRef="Y4" targetRef="G3" />
  <bpmn:sequenceFlow id="Flow_15" name="yes" sourceRef="G3" targetRef="E1" />
  <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="G3" targetRef="X1" />
  <bpmn:textAnnotation id="Note_0"><bpmn:text>BR-009: quote + offsets</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Assoc_0" sourceRef="Y1" targetRef="Note_0" />
  <bpmn:textAnnotation id="Note_1"><bpmn:text>BR-001 gate</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Assoc_1" sourceRef="Y3" targetRef="Note_1" />
  <bpmn:textAnnotation id="Note_2"><bpmn:text>BR-003: binds hash</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Assoc_2" sourceRef="P3" targetRef="Note_2" />
  <bpmn:textAnnotation id="Note_3"><bpmn:text>BR-007, AC-06</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="Assoc_3" sourceRef="Y4" targetRef="Note_3" />
 </bpmn:process>
 <bpmndi:BPMNDiagram id="Diagram_tobe">
  <bpmndi:BPMNPlane id="Plane_tobe" bpmnElement="Collab_tobe">
   <bpmndi:BPMNShape id="Participant_tobe_di" bpmnElement="Participant_tobe" isHorizontal="true"><dc:Bounds x="30" y="30" width="2020" height="600" /></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Lane_A_di" bpmnElement="Lane_A" isHorizontal="true"><dc:Bounds x="60" y="30" width="1990" height="150" /></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="Lane_S_di" bpmnElement="Lane_S" isHorizontal="true"><dc:Bounds x="60" y="180" width="1990" height="150" /></bpmndi:BPMNShape>
