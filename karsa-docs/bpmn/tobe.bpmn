   <bpmndi:BPMNShape id="Lane_X_di" bpmnElement="Lane_X" isHorizontal="true"><dc:Bounds x="60" y="480" width="1990" height="150" /></bpmndi:BPMNShape>
   <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="127" y="87" width="36" height="36" /></bpmndi:BPMNShape>
